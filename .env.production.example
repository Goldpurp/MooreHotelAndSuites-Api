# Configure these in the cloud secret manager. Do not deploy a .env file.
ASPNETCORE_ENVIRONMENT=Production
# Render's service port is reachable only through its edge. ForwardLimit=1
# consumes only the right-most edge hop, not a client-supplied earlier value.
ForwardedHeaders__Enabled=true
ForwardedHeaders__TrustRenderEdge=true
ForwardedHeaders__ForwardLimit=1
ConnectionStrings__DefaultConnection=Host=<PROD_DB_HOST>;Port=5432;Database=<PROD_DB_NAME>;Username=<LEAST_PRIVILEGED_APP_USER>;Password=<PROD_DB_PASSWORD>;Maximum Pool Size=100;Timeout=10;Command Timeout=30;SSL Mode=VerifyFull;Root Certificate=<CA_CERT_PATH>
# Used only by the Render pre-deploy migration bundle. Keep this schema-owner
# credential separate from the least-privileged runtime connection above.
MIGRATION_CONNECTION_STRING=Host=<PROD_DB_HOST>;Port=5432;Database=<PROD_DB_NAME>;Username=<MIGRATION_OWNER>;Password=<MIGRATION_OWNER_PASSWORD>;Timeout=10;Command Timeout=60;SSL Mode=VerifyFull;Root Certificate=<CA_CERT_PATH>
# Must exactly match the Username in DefaultConnection. The pre-deploy script
# grants DML to this existing role and Production startup verifies the match.
DATABASE_RUNTIME_ROLE=<LEAST_PRIVILEGED_APP_USER>
Jwt__Key=<PRODUCTION_RANDOM_SECRET_AT_LEAST_32_BYTES>
Jwt__Issuer=MooreHotels
Jwt__Audience=MooreHotels_Clients
Jwt__ExpirationMinutes=60
PublicAppUrl=https://moorehotelandsuites.com
DashboardUrl=https://admin.moorehotelandsuites.com
Api__PublicBaseUrl=https://api.moorehotelandsuites.com
HotelSettings__Name=<LEGAL_HOTEL_NAME>
HotelSettings__Tagline=<HOTEL_TAGLINE>
HotelSettings__Address=<LEGAL_HOTEL_ADDRESS>
HotelSettings__SupportEmail=<HOTEL_SUPPORT_EMAIL>
HotelSettings__Phone=<HOTEL_PHONE_NUMBER>
HotelSettings__TimeZoneId=Africa/Lagos
HotelSettings__CheckInHour=14
HotelSettings__CheckOutHour=12
AllowedHosts=api.moorehotelandsuites.com;*.onrender.com
AllowedOrigins__0=https://moorehotelandsuites.com
AllowedOrigins__1=https://www.moorehotelandsuites.com
AllowedOrigins__2=https://admin.moorehotelandsuites.com
CloudinarySettings__CloudName=<PROD_CLOUD_NAME>
CloudinarySettings__ApiKey=<PROD_API_KEY>
CloudinarySettings__ApiSecret=<PROD_API_SECRET>
EmailSettings__ApiPass=<PROD_EMAIL_API_KEY>
EmailSettings__SenderEmail=<PROD_SENDER_EMAIL>
EmailSettings__SenderName=Moore Hotels & Suites
EmailSettings__AdminNotificationEmail=<PROD_ADMIN_EMAIL>
EmailSettings__DeliveryMode=Brevo
EmailSettings__MaxRetryAttempts=3
# Keep disabled until a Monnify account, credentials, webhook and controlled
# payment verification have all passed. DirectTransfer remains available.
MonnifySettings__Enabled=false
# Required only when MonnifySettings__Enabled=true:
MonnifySettings__ApiKey=<PROD_MONNIFY_API_KEY>
MonnifySettings__SecretKey=<PROD_MONNIFY_SECRET>
MonnifySettings__ContractCode=<PROD_MONNIFY_CONTRACT>
MonnifySettings__BaseUrl=https://api.monnify.com
MonnifySettings__EnforceWebhookIpAllowlist=true
MonnifySettings__AllowedWebhookIpAddresses__0=35.242.133.146
BankTransferSettings__BankName=<BANK_NAME>
BankTransferSettings__AccountName=<ACCOUNT_NAME>
BankTransferSettings__AccountNumber=<ACCOUNT_NUMBER>
FinancialControls__HighValueRefundThreshold=500000
Pricing__DefaultCurrency=NGN
Pricing__QuoteLifetimeMinutes=15
Pricing__RequireQuoteForBooking=true
# Set these declarations only after completing the linked dashboard action and
# storing evidence outside the repository. Evidence references must not contain secrets.
OperationalReadiness__ManagedBackupsEnabled=true
OperationalReadiness__PointInTimeRecoveryEnabled=true
OperationalReadiness__EncryptedOffProviderBackupsEnabled=true
OperationalReadiness__RecoveryPointObjectiveMinutes=60
OperationalReadiness__RecoveryTimeObjectiveMinutes=240
OperationalReadiness__RestoreDrillMaximumAgeDays=100
OperationalReadiness__LastRestoreDrillAtUtc=<ISO_8601_UTC_TIMESTAMP>
OperationalReadiness__RestoreDrillEvidenceReference=<TICKET_OR_EVIDENCE_ID>
OperationalReadiness__UptimeAlertsEnabled=true
OperationalReadiness__ApiErrorAndLatencyAlertsEnabled=true
OperationalReadiness__QueueAgeAlertsEnabled=true
OperationalReadiness__PaymentAndWebhookAlertsEnabled=true
OperationalReadiness__AlertRoutingEvidenceReference=<ALERT_TEST_EVIDENCE_ID>
OperationalReadiness__QueueAgeWarningMinutes=15
OperationalReadiness__PaymentPendingWarningMinutes=30
ProviderAcceptance__Brevo__CredentialRotationReference=<ROTATION_EVIDENCE_ID>
ProviderAcceptance__Brevo__AcceptedAtUtc=<ISO_8601_UTC_TIMESTAMP>
ProviderAcceptance__Brevo__EvidenceReference=<DELIVERY_TEST_EVIDENCE_ID>
ProviderAcceptance__Cloudinary__CredentialRotationReference=<ROTATION_EVIDENCE_ID>
ProviderAcceptance__Cloudinary__AcceptedAtUtc=<ISO_8601_UTC_TIMESTAMP>
ProviderAcceptance__Cloudinary__EvidenceReference=<UPLOAD_DELETE_RETRY_EVIDENCE_ID>
# Keep false until every Monnify and PCI acceptance gate below is complete.
ProviderAcceptance__HostedPaymentPageOnly=false
ProviderAcceptance__MonnifySandbox__CredentialRotationReference=<ROTATION_EVIDENCE_ID>
ProviderAcceptance__MonnifySandbox__AcceptedAtUtc=<ISO_8601_UTC_TIMESTAMP>
ProviderAcceptance__MonnifySandbox__EvidenceReference=<SANDBOX_EVIDENCE_ID>
ProviderAcceptance__MonnifyWebhook__CredentialRotationReference=<ROTATION_EVIDENCE_ID>
ProviderAcceptance__MonnifyWebhook__AcceptedAtUtc=<ISO_8601_UTC_TIMESTAMP>
ProviderAcceptance__MonnifyWebhook__EvidenceReference=<WEBHOOK_EVIDENCE_ID>
ProviderAcceptance__MonnifyLivePaymentAndRefund__CredentialRotationReference=<ROTATION_EVIDENCE_ID>
ProviderAcceptance__MonnifyLivePaymentAndRefund__AcceptedAtUtc=<ISO_8601_UTC_TIMESTAMP>
ProviderAcceptance__MonnifyLivePaymentAndRefund__EvidenceReference=<LIVE_PAYMENT_REFUND_EVIDENCE_ID>
ProviderAcceptance__PciResponsibilityReview__CredentialRotationReference=<PROVIDER_AOC_REVIEW_ID>
ProviderAcceptance__PciResponsibilityReview__AcceptedAtUtc=<ISO_8601_UTC_TIMESTAMP>
ProviderAcceptance__PciResponsibilityReview__EvidenceReference=<PCI_SCOPE_EVIDENCE_ID>
# Publish these pages before deployment. Versions must change whenever the
# corresponding legal text changes. The retention period requires legal and
# records-management approval; the example is seven years.
Privacy__RequirePolicyAcceptance=true
Privacy__CurrentPrivacyPolicyVersion=<APPROVED_POLICY_VERSION>
Privacy__CurrentBookingTermsVersion=<APPROVED_TERMS_VERSION>
Privacy__PrivacyPolicyUrl=https://moorehotelandsuites.com/privacy
Privacy__BookingTermsUrl=https://moorehotelandsuites.com/terms
Privacy__EnableRetentionWorker=true
Privacy__GuestRetentionDays=2555
Security__RequireStaffMfa=true
Runtime__EnableSwagger=false
Runtime__EnableExternalServices=true
Runtime__AutoConfirmEmail=false
Runtime__EnableRateLimiting=true
Runtime__RequirePublicBookingEmailVerification=true
Runtime__EnableMediaDeletion=true
Runtime__UseHttpsRedirection=false
Database__ApplyMigrationsOnStartup=false
# Set true only when using Render's private dpg-*-a hostname with external
# database access blocked. All other Production databases must use TLS.
Database__TrustRenderPrivateNetwork=false
DataProtection__KeysPath=/var/data/moorehotels-keys
# Use either a mounted PFX path or a base64-encoded PFX secret.
DataProtection__CertificateBase64=<BASE64_ENCODED_DATA_PROTECTION_PFX>
DataProtection__CertificatePassword=<DATA_PROTECTION_CERTIFICATE_PASSWORD>
SeedAdmin=false
