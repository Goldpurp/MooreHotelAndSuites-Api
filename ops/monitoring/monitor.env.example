# Install as /etc/moore-monitor/monitor.env, owned by root and mode 0600.
# Provision a separate Healthchecks check: period 5 minutes, grace 3 minutes.
# Configure and test delivery to the two named operators before activation.
HEALTHCHECKS_MONITOR_PING_URL=https://hc-ping.com/REPLACE_WITH_CHECK_UUID
MONITOR_ENDPOINT=https://api.moorehotelandsuites.com/health/operations
MONITOR_LATENCY_LIMIT_SECONDS=2.0
